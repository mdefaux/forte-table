{
  "name": "forte-table",
  "version": "2.0.0",
  "description": "A React table management library from Forte.",
  "main": "dist/index.js",
  "scripts": {
    "start": "webpack serve --open",
    "transpile": "babel src -d dist --copy-files",
    "prepublishOnly": "npm run transpile",
    "build": "webpack --mode production",
    "deploy": "gh-pages -d examples/dist",
    "publish-demo": "npm run build && npm run deploy",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdefaux/forte-table.git"
  },
  "keywords": [
    "Table",
    "Forte",
    "React",
    "gui",
    "design"
  ],
  "author": "Maurice Defaux",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mdefaux/forte-table/issues"
  },
  "homepage": "https://github.com/mdefaux/forte-table#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.0",
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.24.0",
    "@playwright/test": "^1.65.0",
    "babel-loader": "^9.2.0",
    "css-loader": "^7.1.0",
    "gh-pages": "^6.1.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^1.3.1",
    "lint-staged": "^8.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "linters": {
      "*.{js,json,css,md}": [
        "prettier --write",
        "git add"
      ]
    },
    "ignore": [
      "**/dist/**"
    ]
  }
}
